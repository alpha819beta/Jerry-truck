# Copy to .env.local and fill in. These values are built into the site and are
# safe to be public: your data is protected by firestore.rules, not by these.

# ─── Firebase (Project settings → General → Your apps → Web app config) ─
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# ─── Site addresses (used in emailed links) ────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Owner portal address. With the two-site setup in the README this is the
# admin site, e.g. https://appalachian-assists-admin.web.app
NEXT_PUBLIC_ADMIN_URL="http://localhost:3000"

# ─── EmailJS (free plan: 200 emails/month) ─────────────────────────────
# Owner alerts for new estimates/bookings, emailed invoices, newsletters.
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=""
NEXT_PUBLIC_EMAILJS_SERVICE_ID=""
# Template whose "To" is fixed to YOUR email (new request alerts)
NEXT_PUBLIC_EMAILJS_OWNER_TEMPLATE=""
# Template whose "To" is {{to_email}} (invoices + newsletter)
NEXT_PUBLIC_EMAILJS_CUSTOMER_TEMPLATE=""
