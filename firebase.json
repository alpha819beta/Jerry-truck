{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": [
    {
      "target": "public",
      "public": "out",
      "ignore": ["firebase.json", "**/.*", "admin/**"],
      "cleanUrls": true,
      "trailingSlash": true,
      "headers": [
        {
          "source": "/_next/static/**",
          "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
        }
      ]
    },
    {
      "target": "admin",
      "public": "out",
      "ignore": ["firebase.json", "**/.*"],
      "cleanUrls": true,
      "trailingSlash": true,
      "redirects": [{ "source": "/", "destination": "/admin/", "type": 302 }],
      "headers": [
        {
          "source": "**",
          "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
        }
      ]
    }
  ],
  "emulators": {
    "firestore": { "port": 8080 },
    "auth": { "port": 9099 },
    "hosting": { "port": 5000 },
    "ui": { "enabled": true }
  }
}
